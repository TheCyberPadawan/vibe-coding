{
  "name": "rempart",
  "productName": "Rempart",
  "version": "1.1.0",
  "description": "Audit de durcissement de Windows : vérifie, explique et corrige, de façon réversible.",
  "author": "Rempart",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/icon.js",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "fr.rempart.app",
    "productName": "Rempart",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "checks.js", "ps.js", "app/**/*", "build/icon.png"],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rempart",
      "language": "1036"
    }
  }
}
