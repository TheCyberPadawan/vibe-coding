{
  "name": "atelier-pdf",
  "productName": "Atelier PDF",
  "version": "1.9.0",
  "description": "Éditeur PDF gratuit : texte, annotations, formulaires, signature, caviardage, OCR, protection, pages.",
  "author": "Atelier PDF",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "vendor": "node scripts/vendor.js",
    "start": "npm run vendor && electron .",
    "dist": "npm run vendor && electron-builder --win nsis"
  },
  "devDependencies": {
    "@fontsource/dancing-script": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "5.1.1",
    "tesseract.js-core": "5.1.1"
  },
  "build": {
    "appId": "fr.atelierpdf.app",
    "productName": "Atelier PDF",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "Document PDF",
        "description": "Document PDF",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Atelier PDF",
      "language": "1036"
    }
  }
}
